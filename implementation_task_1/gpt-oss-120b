#include <memory>
#include <rclcpp/rclcpp.hpp>
#include <moveit/move_group_interface/move_group_interface.h>
#include <geometry_msgs/msg/pose.hpp>

int main (int argc, char * argv[])
{
  // Initialize ROS and create the Node
  rclcpp::init(argc, argv);
  auto node = rclcpp::Node::make_shared("hello_moveit");

  // Create a ROS logger
  auto logger = node->get_logger();

  // Create the MoveIt MoveGroup Interface
  // (panda_arm is the name of the MoveIt planning group for the Panda robot)
  moveit::planning_interface::MoveGroupInterface move_group(node, "panda_arm");

  // Set a target Pose
  geometry_msgs::msg::Pose target_pose;
  target_pose.orientation.w = 1.0;          // neutral orientation (unit quaternion)
  target_pose.position.x   = 0.28;          // x‑position
  target_pose.position.y   = -0.2;          // y‑position
  target_pose.position.z   = 0.5;           // z‑position
  move_group.setPoseTarget(target_pose);

  // Create a plan to that target pose
  moveit::planning_interface::MoveGroupInterface::Plan plan;
  bool planning_success =
      (move_group.plan(plan) == moveit::planning_interface::MoveItErrorCode::SUCCESS);

  if (!planning_success)
  {
    RCLCPP_ERROR(logger, "Planning failed!");
    rclcpp::shutdown();
    return 1;
  }

  // Execute the plan
  moveit::planning_interface::MoveItErrorCode exec_status = move_group.execute(plan);
  if (exec_status != moveit::planning_interface::MoveItErrorCode::SUCCESS)
  {
    RCLCPP_ERROR(logger, "Execution failed!");
    rclcpp::shutdown();
    return 1;
  }

  // Shutdown ROS
  rclcpp::shutdown();
  return 0;
}

