<?xml version="1.0"?>
<robot name="my_robot">

  <!-- ============================================================= -->
  <!--  MATERIALS                                                   -->
  <!-- ============================================================= -->
  <material name="green">
    <color rgba="0 0.8 0 1"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- ============================================================= -->
  <!--  LINKS                                                       -->
  <!-- ============================================================= -->

  <!-- 1) Base (green box) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/> <!-- half of height = 0.2/2 -->
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <inertia ixx="0.04" ixy="0.0" ixz="0.0"
               iyy="0.05" iyz="0.0"
               izz="0.06"/>
    </inertial>
  </link>

  <!-- 2) LIDAR (white small box) -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- 3) Left wheel (grey cylinder) -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0.21 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0.21 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0.21 0.05" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.0015" iyz="0.0"
               izz="0.0025"/>
    </inertial>
  </link>

  <!-- 4) Right wheel (grey cylinder) -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 -0.21 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.21 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 -0.21 0.05" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.0015" iyz="0.0"
               izz="0.0025"/>
    </inertial>
  </link>

  <!-- 5) Caster wheel (grey cylinder) -->
  <link name="caster_wheel_link">
    <visual>
      <origin xyz="-0.25 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="-0.25 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="-0.25 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0"
               iyy="0.0008" iyz="0.0"
               izz="0.0012"/>
    </inertial>
  </link>

  <!-- 6) Virtual footprint link (zero‑size, used for odom) -->
  <link name="base_footprint"/>

  <!-- ============================================================= -->
  <!--  JOINTS                                                      -->
  <!-- ============================================================= -->

  <!-- Base ↔ footprint (fixed) -->
  <joint name="base_to_footprint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR on top of the base (fixed) -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <!-- Base height/2 = 0.1 m, LIDAR half height = 0.025 m -->
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
  </joint>

  <!-- Left wheel (continuous) -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_wheel_link"/>
    <origin xyz="0 0.21 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" velocity="10.0"/>
  </joint>

  <!-- Right wheel (continuous) -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_wheel_link"/>
    <origin xyz="0 -0.21 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" velocity="10.0"/>
  </joint>

  <!-- Caster wheel (fixed – it does not drive) -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel_link"/>
    <origin xyz="-0.25 0 0.05" rpy="0 0 0"/>
  </joint>

</robot>